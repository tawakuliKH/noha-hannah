{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noha-hannah-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://nohannah.co.uk,https://www.nohannah.co.uk,http://localhost:5173,http://localhost:4173",
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "ratelimits": [{"name":"CHAT_RATE_LIMITER","namespace_id":"184761","simple":{"limit":10,"period":60}}]
}
